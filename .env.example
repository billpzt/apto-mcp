# Copy to BOTH .env.local (Next.js) and .env (Prisma CLI reads this one, not .env.local).

# ---- Database -------------------------------------------------------------
# Local: run `npx prisma dev -n apto -d`. It prints a connection string. Paste it
# into both variables below, replacing the port.
#
# Note the trailing &pgbouncer=true on DATABASE_URL and NOT on DIRECT_URL. It is
# required: prisma dev serves through a connection pooler, and without that flag
# Prisma reuses prepared statement names across pooled connections and every page
# that reads the database fails with 'prepared statement "s0" already exists'.
DATABASE_URL="postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable&pgbouncer=true"
DIRECT_URL="postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable"

# Hosted Postgres instead (optional, see README). Use the POOLED endpoint for
# DATABASE_URL and keep connect_timeout, or cold starts will look like outages.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.example.com/db?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# The UNPOOLED endpoint, used for migrations only. Never used by the app.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.example.com/db?sslmode=require"

# ---- App ------------------------------------------------------------------
# Your own deployment's URL. No default is assumed anywhere in the codebase.
APTO_BASE_URL="http://localhost:3000"

# Gates the whole app behind a single password. Leave empty to disable auth
# for local development. Set a real value before deploying anywhere public.
APP_PASSWORD=""

# Lets an MCP client or script call the REST API without a browser session.
# This is what the stdio bridge in apto-mcp/ sends. Generate your own:
# `openssl rand -hex 32`
APTO_API_KEY=""

# Gates the remote MCP endpoint at /api/mcp, used by hosted connectors rather
# than the stdio bridge. It is deliberately a SECOND credential: the bridge
# runs on your machine, the remote endpoint is reachable from the internet, so
# revoking one should not revoke the other. Required outside development, and
# /api/mcp refuses every request when it is unset.
# `openssl rand -hex 32`
APTO_MCP_TOKEN=""

# ---- AI providers (set at least one) --------------------------------------
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
ZAI_API_KEY=""
OPENROUTER_API_KEY=""

# ---- Optional integrations ------------------------------------------------
# Adzuna job aggregator. Free tier is roughly 1k requests/day.
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""

# ---- Owner profile (optional) ----------------------------------------------
# Freeform one-two line professional summary (role, stack, target comp) fed
# into the "Check a job" analyzer prompt so grading has something concrete to
# compare a JD against. Leave unset for a generic prompt with no candidate
# profile injected. NEXT_PUBLIC_OWNER_NAME/EMAIL (used in the sidebar and AI
# prompts) are set the same way, see components/Sidebar.tsx.
# OWNER_PROFILE="Senior Backend Engineer | Remote, US timezone | Target: $120k-$160k/yr | Stack: Python, Go, Kubernetes"
